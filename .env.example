# Configures the local Phase 1 tutor API without exposing secrets to the extension.
OPENAI_API_KEY=
TUTOR_PROVIDER=openai
TUTOR_TEXT_MODEL=gpt-6.1-terra
TUTOR_VISION_MODEL=gpt-6.1-terra
TUTOR_REASONING_EFFORT=low
TUTOR_MAX_OUTPUT_TOKENS=1200

# Add these rates when using a model that is not in server/modelPricing.ts.
# TUTOR_MODEL_PRICING_JSON={"text-model":{"inputUsdPerMillion":0,"cachedInputUsdPerMillion":0,"cacheWriteUsdPerMillion":0,"outputUsdPerMillion":0,"effectiveDate":"YYYY-MM-DD"},"vision-model":{"inputUsdPerMillion":0,"cachedInputUsdPerMillion":0,"cacheWriteUsdPerMillion":0,"outputUsdPerMillion":0,"effectiveDate":"YYYY-MM-DD"}}
# The single-model rate variables below are a shorter fallback.
# TUTOR_INPUT_USD_PER_MILLION=0
# TUTOR_CACHED_INPUT_USD_PER_MILLION=0
# TUTOR_CACHE_WRITE_USD_PER_MILLION=0
# TUTOR_OUTPUT_USD_PER_MILLION=0
# TUTOR_PRICING_EFFECTIVE_DATE=YYYY-MM-DD
