{
    "manifest_version": 3,
    "name": "Blackboard Lecture Tutor",
    "version": "0.4.0",
    "description": "Download authorized Class.com recordings and tutor from durable playback-aware lecture evidence.",
    "permissions": [
        "downloads",
        "storage",
        "webRequest"
    ],
    "host_permissions": [
        "https://*.class.com/*",
        "http://127.0.0.1:4387/*"
    ],
    "background": {
        "service_worker": "dist/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.class.com/*"
            ],
            "js": [
                "dist/content.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "action": {
        "default_title": "Blackboard Lecture Tutor"
    }
}
