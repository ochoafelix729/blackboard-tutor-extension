{
    "name": "blackboard-tutor-extension",
    "version": "0.4.0",
    "private": true,
    "description": "A Class.com lecture downloader and context-aware tutoring extension.",
    "scripts": {
        "build": "esbuild src/background.ts src/content.ts --bundle --outdir=dist --format=iife --platform=browser --target=chrome120",
        "check": "npm run typecheck && npm run build",
        "server": "node --env-file-if-exists=.env --import tsx server/server.ts",
        "typecheck": "tsc --noEmit --pretty false"
    },
    "devDependencies": {
        "@types/chrome": "^0.1.31",
        "@types/katex": "^0.16.8",
        "@types/markdown-it": "^14.2.0",
        "@types/node": "^24.10.0",
        "esbuild": "^0.28.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "eventsource-parser": "^3.1.1",
        "katex": "^0.19.1",
        "markdown-it": "^15.0.3",
        "markdown-it-texmath": "^1.0.0"
    }
}
