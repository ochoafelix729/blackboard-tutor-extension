{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": [
            "DOM",
            "ES2022"
        ],
        "types": [
            "chrome",
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "useDefineForClassFields": true,
        "skipLibCheck": true
    },
    "include": [
        "server/**/*.ts",
        "src/**/*.ts"
    ]
}
